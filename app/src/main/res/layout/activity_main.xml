<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/versionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/enableSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/enable"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/boostLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:textColor="?android:attr/colorAccent"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gainLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/boostBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/preset100" style="@style/Preset" android:text="100%" />
            <Button android:id="@+id/preset150" style="@style/Preset" android:text="150%" />
            <Button android:id="@+id/preset200" style="@style/Preset" android:text="200%" />
            <Button android:id="@+id/preset400" style="@style/Preset" android:text="400%" />
            <Button android:id="@+id/preset600" style="@style/Preset" android:text="600%" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/media_volume"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/volumeBar"
            android:layout_width="match_parent"
            android:layout_height="48dp" />


        <TextView
            style="@style/SectionTitle"
            android:text="@string/equalizer" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/eqFlat" style="@style/Preset" android:text="@string/preset_flat" />
            <Button android:id="@+id/eqVoice" style="@style/Preset" android:text="@string/preset_voice" />
            <Button android:id="@+id/eqMovies" style="@style/Preset" android:text="@string/preset_movies" />
            <Button android:id="@+id/eqMusic" style="@style/Preset" android:text="@string/preset_music" />
            <Button android:id="@+id/eqBass" style="@style/Preset" android:text="@string/preset_bass" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="88dp"
                android:layout_height="wrap_content"
                android:text="@string/bass" />

            <SeekBar
                android:id="@+id/bassBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/bassValue"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="88dp"
                android:layout_height="wrap_content"
                android:text="@string/mid" />

            <SeekBar
                android:id="@+id/midBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/midValue"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="88dp"
                android:layout_height="wrap_content"
                android:text="@string/treble" />

            <SeekBar
                android:id="@+id/trebleBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/trebleValue"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="88dp"
                android:layout_height="wrap_content"
                android:text="@string/bass_boost" />

            <SeekBar
                android:id="@+id/bassBoostBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/bassBoostValue"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end" />
        </LinearLayout>

        <!-- Volume-buttons feature suspended; see the note in AndroidManifest.xml. -->
        <LinearLayout
            android:id="@+id/volumeKeysSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/volume_keys_label" />

            <Switch
                android:id="@+id/volumeKeysSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/volume_keys_switch"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.7"
                android:text="@string/volume_keys_hint"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/attach_failed"
            android:textColor="#E65100"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:alpha="0.7"
            android:text="@string/hint"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
